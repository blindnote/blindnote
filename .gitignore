# Runtime state: pending notes and their keys live here. Never committed and
# never copied anywhere else -- durability comes from block-level replication,
# not from copies in time (CLAUDE.md rule 7).
/data

# Local tooling and editor leftovers
codedb.snapshot
*.bak
.DS_Store

# zigrep local archive
.zigrep_archive

# Internal handoff / design-contract doc -- kept local, never published. It is an
# AI-agent handoff (process rules, infra pointers), not part of the public source;
# the design story that IS public lives in README.md, SECURITY.md and docs/devlog.md.
/CLAUDE.md
