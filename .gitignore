# Build output
/target
**/node_modules
/client/dist

# Playwright E2E artefacts
/client/test-results
/client/playwright-report
/client/.playwright
/client/blob-report

# Runtime state: pending notes and their keys live here. Never committed and
# never copied anywhere else -- durability comes from block-level replication,
# not from copies in time (CLAUDE.md rule 7).
/data

# Local tooling and editor leftovers
codedb.snapshot
*.bak
.DS_Store

# zigrep local archive
.zigrep_archive
